{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/destinations/[slug]",
      "regex": "^/destinations/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/destinations/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/admin/dashboard",
      "regex": "^/admin/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/dashboard(?:/)?$"
    },
    {
      "page": "/admin/login",
      "regex": "^/admin/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/login(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/dubai-pet-taxi",
      "regex": "^/dubai\\-pet\\-taxi(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dubai\\-pet\\-taxi(?:/)?$"
    },
    {
      "page": "/faq",
      "regex": "^/faq(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/faq(?:/)?$"
    },
    {
      "page": "/get-a-quote",
      "regex": "^/get\\-a\\-quote(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/get\\-a\\-quote(?:/)?$"
    },
    {
      "page": "/how-it-works",
      "regex": "^/how\\-it\\-works(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/how\\-it\\-works(?:/)?$"
    },
    {
      "page": "/international-pet-relocation",
      "regex": "^/international\\-pet\\-relocation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/international\\-pet\\-relocation(?:/)?$"
    },
    {
      "page": "/resources",
      "regex": "^/resources(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/resources(?:/)?$"
    },
    {
      "page": "/reviews",
      "regex": "^/reviews(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/reviews(?:/)?$"
    },
    {
      "page": "/why-global-pet-cab",
      "regex": "^/why\\-global\\-pet\\-cab(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/why\\-global\\-pet\\-cab(?:/)?$"
    },
    {
      "page": "/international-pet-relocation/from-dubai",
      "regex": "^/international\\-pet\\-relocation/from\\-dubai(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/international\\-pet\\-relocation/from\\-dubai(?:/)?$"
    },
    {
      "page": "/international-pet-relocation/to-dubai",
