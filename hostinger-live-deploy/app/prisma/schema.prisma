datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model TaxiEnquiry {
  id             String   @id @default(uuid())
  referenceId    String   @unique
  pickupLocation String
  dropLocation   String
  distanceKm     Float
  tripType       String   @default("one_way") // one_way | round_trip
  petType        String   @default("Dog")
  numPets        Int      @default(1)
  travelDate     String
  pickupTime     String
  estimatedFare  Float
  breakdownJson  String
  customerName   String
  phone          String
  whatsapp       String
  email          String
  petName        String?
  breed          String?
  crateAvailable String   @default("No")
  notes          String?
  status         String   @default("New") // New | Contacted | Confirmed | Driver Assigned | In Transit | Completed | Cancelled
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  createdAt      DateTime @default(now())
}

model InternationalEnquiry {
  id                String   @id @default(uuid())
  referenceId       String   @unique
  direction         String   // from_dubai | to_dubai
  originCountry     String
  originCity        String
  destCountry       String
  destCity          String
  travelDate        String
  petType           String
  petName           String
  breed             String?
  age               String?
  gender            String?
  weightKg          String?
  dimensions        String?
  crateStatus       String   @default("Not Sure")
  microchipStatus   String   @default("Not Sure")
  vaccinationStatus String   @default("Not Sure")
  rabiesStatus      String   @default("Not Sure")
  servicesJson      String
  customerName      String
  phone             String
  whatsapp          String
  email             String
  notes             String?
  status            String   @default("New") // New | Reviewing | Quote Preparing | Quote Sent | Follow-up | Confirmed | Completed | Cancelled
  createdAt         DateTime @default(now())
}

model PricingSettings {
  id                   String   @id @default("default")
  baseFare             Float    @default(60.0)
  includedKm           Float    @default(5.0)
  perKmRate            Float    @default(4.0)
  minimumFare          Float    @default(80.0)
  additionalPetCharge  Float    @default(25.0)
  roundTripMultiplier  Float    @default(1.8) // 20% discount on round trip
  airportSurcharge     Float    @default(30.0)
  nightSurcharge       Float    @default(20.0)
  weekendSurcharge     Float    @default(15.0)
  vatEnabled           Boolean  @default(true)
  vatPercentage        Float    @default(5.0)
  updatedAt            DateTime @updatedAt
}

model Review {
  id           String   @id @default(uuid())
  customerName String
  petName      String?
  routeLabel   String   // e.g. "DUBAI MARINA → DXB" or "DUBAI → LONDON"
  rating       Int      @default(5)
  comment      String
  source       String   @default("Google Review")
  verified     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model FAQ {
  id       String @id @default(uuid())
  category String // taxi | international | general
  question String
  answer   String
  order    Int    @default(0)
}
